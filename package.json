{
  "name": "showdown-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "A desktop workspace for Pokémon Showdown.",
  "main": "app/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "build:showdex": "node scripts/build-showdex.js",
    "build:practice": "node scripts/build-practice.js",
    "bots:setup": "node scripts/bots/setup.cjs",
    "bots:serve": "node scripts/bots/service.cjs",
    "test:bots": "node scripts/bots/test.cjs",
    "test": "node --test tests/*.test.js",
    "test:desktop": "node scripts/test-desktop.js",
    "test:showdex:live": "node scripts/test-desktop.js --showdex-live",
    "test:replays:live": "node scripts/test-desktop.js --replay-review-live",
    "test:shell:live": "node scripts/test-desktop.js --shell-live",
    "test:practice": "node scripts/test-desktop.js --practice",
    "pack:win:dir": "electron-builder --win --dir --x64 --publish never",
    "pack:win": "electron-builder --win nsis --x64 --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.js",
    "smoke:practice-packaged": "node scripts/smoke-packaged.js --practice",
    "check": "node scripts/check.js"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "ws": "8.18.3"
  }
}
